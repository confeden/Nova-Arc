{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Arc",
  "version": "0.7.0",
  "identifier": "net.novaarc.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Nova Arc",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  }
}
